#!/usr/bin/env bash
set -euo pipefail

# Pi's package manager shells out to `npm`, which is not installed (Bun only).
# Resolve global packages against the pinned bundle and no-op installs,
# so that NPM packages come from the bundle and nothing is downloaded at runtime.

case "$1" in
    install)
        echo "INSTALL NOOP: ${*}" >&2
        ;;
    root)
        if [[ "$2" = "-g" ]]
        then
            echo "${PI_HOME}/node_modules"
        else
            echo node_modules
        fi
        ;;
    *)
        echo "fake-npm: unsupported command: ${*}" >&2
        exit 1
        ;;
esac
